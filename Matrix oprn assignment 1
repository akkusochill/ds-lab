#include <stdio.h>
#include <stdlib.h>

void accept(int mat[10][10], int rows, int cols)
{
    printf("Enter the values of matrix:\n");

    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            scanf("%d",&mat[i][j]);
        }
    }
}

void display(int mat[10][10], int rows, int cols)
{
    printf("Matrix is:\n");

    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            printf("%5d",mat[i][j]);
        }
        printf("\n");
    }
}

void addition(int mat1[10][10], int mat2[10][10], int rows, int cols)
{
    int mat3[10][10];

    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            mat3[i][j]=mat1[i][j]+mat2[i][j];
        }
    }

    printf("\nResultant Matrix:\n");
    display(mat3,rows,cols);
}

void subtraction(int mat1[10][10], int mat2[10][10], int rows, int cols)
{
    int mat3[10][10];

    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            mat3[i][j]=mat1[i][j]-mat2[i][j];
        }
    }

    printf("\nResultant Matrix:\n");
    display(mat3,rows,cols);
}

void transpose(int mat[10][10], int rows, int cols)
{
    int trans[10][10];

    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            trans[j][i]=mat[i][j];
        }
    }

    printf("\nTranspose Matrix:\n");
    display(trans,cols,rows);
}

void multiplication(int mat1[10][10], int mat2[10][10],
                    int r1,int c1,int r2,int c2)
{
    int result[10][10]={0};

    if(c1!=r2)
    {
        printf("\nMatrix multiplication is not possible.\n");
        return;
    }

    for(int i=0;i<r1;i++)
    {
        for(int j=0;j<c2;j++)
        {
            for(int k=0;k<c1;k++)
            {
                result[i][j]+=mat1[i][k]*mat2[k][j];
            }
        }
    }

    printf("\nResultant Matrix:\n");
    display(result,r1,c2);
}

int main()
{
    int m,n,ch;

    int array1[10][10];
    int array2[10][10];

    printf("Enter number of rows and columns: ");
    scanf("%d%d",&m,&n);

    printf("\nEnter Matrix 1\n");
    accept(array1,m,n);

    printf("\nMatrix 1\n");
    display(array1,m,n);

    printf("\nEnter Matrix 2\n");
    accept(array2,m,n);

    printf("\nMatrix 2\n");
    display(array2,m,n);

    while(1)
    {
        printf("\n========== MENU ==========\n");
        printf("1. Addition\n");
        printf("2. Subtraction\n");
        printf("3. Transpose\n");
        printf("4. Multiplication\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1:
                addition(array1,array2,m,n);
                break;

            case 2:
                subtraction(array1,array2,m,n);
                break;

            case 3:
                printf("\nTranspose of Matrix 1\n");
                transpose(array1,m,n);

                printf("\nTranspose of Matrix 2\n");
                transpose(array2,m,n);
                break;

            case 4:
                multiplication(array1,array2,m,n,m,n);
                break;

            case 5:
                printf("Thank You!\n");
                exit(0);

            default:
                printf("Invalid Choice!\n");
        }
    }

    return 0;
}
